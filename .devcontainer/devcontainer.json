{
  "name": "Tareas Escolares en Solana",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "npm install && npm run cliente",
  "remoteUser": "node",
  "forwardPorts": [5173],
